# Raw datasets: download locally, see README
data/raw/*
!data/raw/.gitkeep

# Trained models and large artefacts
models/
*.pt
*.h5
*.keras
*.joblib
*.pkl

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.venv/

# OS / secrets
.DS_Store
.env

# Processed data: rebuild locally with src/data.py
data/processed/*
!data/processed/.gitkeep
!data/processed/splits.csv

# Local Agent inputs and evaluation outputs
local_inputs/
outputs/agent/

# Local provider profiles (credentials live in macOS Keychain)
configs/*.local.yaml

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ee6405:agent:result:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "needs_review",
        "error"
      ]
    },
    "decision": {
      "enum": [
        "fraud",
        "legitimate",
        "abstain"
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "explanation": {
      "type": "string",
      "maxLength": 2000
    },
    "views": {
      "type": "object",
      "properties": {
        "original": {
          "type": "string"
        },
        "normalised": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "original",
        "normalised"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^section_[0-9]{4}_(original|normalised)$": {
          "type": "string"
        }
      }
    },
    "input_policy": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "prefix_chars_v1",
            "document_windows_v1"
          ]
        },
        "max_chars": {
          "type": "integer"
        },
        "original_chars": {
          "type": "integer"
        },
        "used_chars": {
          "type": "integer"
        },
        "clipped": {
          "type": "boolean"
        },
        "original_offset": {
          "const": 0
        }
      },
      "required": [
        "name",
        "max_chars",
        "original_chars",
        "used_chars",
        "clipped",
        "original_offset"
      ],
      "additionalProperties": false
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "view": {
            "type": "string",
            "pattern": "^(original|normalised|section_[0-9]{4}_(original|normalised))$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "kind",
          "view",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "pattern": "^(original|normalised|section_[0-9]{4}_(original|normalised))$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "view",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "classifier_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "canonical_train_verified",
              "unverified_integration_only"
            ]
          },
          "original_classes": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer",
                "number"
              ]
            }
          },
          "predicted_label": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "fraud",
              "legitimate",
              "abstain"
            ]
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "fraud_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "score_kind": {
            "enum": [
              "model_probability_uncalibrated",
              "decision_margin",
              "label_only"
            ]
          },
          "view": {
            "type": "string",
            "pattern": "^(original|normalised|section_[0-9]{4}_(original|normalised))$"
          },
          "preprocessing": {
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "provenance",
          "original_classes",
          "predicted_label",
          "decision",
          "scores",
          "fraud_score",
          "score_kind",
          "view",
          "preprocessing"
        ],
        "additionalProperties": false
      }
    },
    "retrieved_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "similarity": {
            "type": "number"
          },
          "training_label": {
            "enum": [
              "fraud",
              "legitimate"
            ]
          },
          "partition": {
            "const": "canonical_seed0_train"
          }
        },
        "required": [
          "case_id",
          "excerpt",
          "similarity",
          "training_label",
          "partition"
        ],
        "additionalProperties": false
      }
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "inputs": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "array",
              "null"
            ]
          },
          "elapsed_ms": {
            "type": "number"
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "enum": [
              "model_tool_call",
              "classifier_only",
              "fixed_workflow",
              "boundary_policy",
              "triage_gate"
            ]
          }
        },
        "required": [
          "tool",
          "inputs",
          "result",
          "elapsed_ms",
          "error",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "elapsed_ms": {
      "type": "number"
    },
    "llm_calls": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "accounting_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "accounting_complete"
      ],
      "additionalProperties": false
    },
    "cost_estimate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "currency": {
              "const": "USD"
            },
            "amount": {
              "type": "number"
            }
          },
          "required": [
            "currency",
            "amount"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "mock": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "model",
        "mock"
      ],
      "additionalProperties": false
    },
    "stop_reason": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "selected_model_id",
        "selection_reason",
        "candidates_called",
        "input_features"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "fixed_model",
            "rule_router",
            "agent_router"
          ]
        },
        "selected_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_reason": {
          "type": "string"
        },
        "candidates_called": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_features": {
          "type": "object"
        },
        "proposed_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "preprocessing": {
          "type": "object",
          "required": [
            "classifier_view",
            "normalisation_changes"
          ],
          "additionalProperties": false,
          "properties": {
            "classifier_view": {
              "const": "normalised"
            },
            "normalisation_changes": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "boundary_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "primary_model",
              "score_kind",
              "distance",
              "threshold",
              "near_boundary",
              "policy_enabled",
              "secondary_model",
              "secondary_executed",
              "resolution"
            ],
            "properties": {
              "primary_model": {
                "type": "string"
              },
              "score_kind": {
                "type": "string"
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "threshold": {
                "type": "number",
                "minimum": 0
              },
              "near_boundary": {
                "type": "boolean"
              },
              "policy_enabled": {
                "type": "boolean"
              },
              "secondary_model": {
                "type": "string"
              },
              "secondary_executed": {
                "type": "boolean"
              },
              "resolution": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "escalation_reasons",
        "overview",
        "read_sections",
        "assessments",
        "selected_assessment_id",
        "coverage_complete",
        "clarification",
        "context_answers",
        "next_steps",
        "max_source_chars"
      ],
      "properties": {
        "path": {
          "enum": [
            "unresolved",
            "fast",
            "escalated"
          ]
        },
        "escalation_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "long_document",
              "no_substantive_window",
              "near_boundary",
              "classifier_disagreement"
            ]
          }
        },
        "overview": {
          "type": [
            "object",
            "null"
          ]
        },
        "read_sections": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assessment_id",
              "section_id",
              "candidate_id",
              "classifier"
            ],
            "additionalProperties": false,
            "properties": {
              "assessment_id": {
                "type": "string"
              },
              "section_id": {
                "type": "string",
                "pattern": "^s[0-9]{4}$"
              },
              "candidate_id": {
                "enum": [
                  "word_lr",
                  "word_nb",
                  "word_svm",
                  "char_svm"
                ]
              },
              "classifier": {
                "type": "object",
                "properties": {
                  "model_id": {
                    "type": "string"
                  },
                  "provenance": {
                    "enum": [
                      "canonical_train_verified",
                      "unverified_integration_only"
                    ]
                  },
                  "original_classes": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "integer",
                        "number"
                      ]
                    }
                  },
                  "predicted_label": {
                    "type": "string"
                  },
                  "decision": {
                    "enum": [
                      "fraud",
                      "legitimate",
                      "abstain"
                    ]
                  },
                  "scores": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  },
                  "fraud_score": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "score_kind": {
                    "enum": [
                      "model_probability_uncalibrated",
                      "decision_margin",
                      "label_only"
                    ]
                  },
                  "view": {
                    "type": "string",
                    "pattern": "^(original|normalised|section_[0-9]{4}_(original|normalised))$"
                  },
                  "preprocessing": {
                    "type": "string"
                  }
                },
                "required": [
                  "model_id",
                  "provenance",
                  "original_classes",
                  "predicted_label",
                  "decision",
                  "scores",
                  "fraud_score",
                  "score_kind",
                  "view",
                  "preprocessing"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "selected_assessment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "clarification": {
          "type": [
            "object",
            "null"
          ]
        },
        "context_answers": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "next_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_source_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000000
        },
        "finalization_compacted": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "mode",
    "channel",
    "status",
    "decision",
    "needs_review",
    "explanation",
    "views",
    "input_policy",
    "indicators",
    "evidence",
    "classifier_results",
    "retrieved_cases",
    "tool_trace",
    "elapsed_ms",
    "llm_calls",
    "usage",
    "cost_estimate",
    "provider",
    "stop_reason",
    "errors",
    "unsupported_claims"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": "abstain"
          },
          "needs_review": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "fraud",
              "legitimate"
            ]
          },
          "needs_review": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_review"
          }
        }
      },
      "then": {
        "properties": {
          "needs_review": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "needs_review"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "enum": [
              "classifier_only",
              "direct_llm",
              "agent",
              "fixed_workflow",
              "fixed_model",
              "rule_router",
              "agent_router",
              "adaptive_agent",
              "document_classifier",
              "document_fixed"
            ]
          },
          "channel": {
            "enum": [
              "sms",
              "email",
              "phone"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "fixed_model",
              "rule_router",
              "agent_router"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "needs_review"
            ]
          }
        }
      },
      "then": {
        "required": [
          "routing"
        ],
        "properties": {
          "schema_version": {
            "enum": [
              "1.1",
              "1.2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "adaptive_agent",
              "document_classifier",
              "document_fixed"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "needs_review"
            ]
          }
        }
      },
      "then": {
        "required": [
          "triage"
        ],
        "properties": {
          "schema_version": {
            "const": "1.3"
          },
          "input_policy": {
            "properties": {
              "name": {
                "const": "document_windows_v1"
              }
            }
          }
        }
      }
    }
  ]
}
